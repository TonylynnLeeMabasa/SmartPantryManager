<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:backgroundTint="#FFFFFF"
    android:elevation="0dp"
    android:radius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/purchasedCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#2F6B42" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shoppingItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eggs"
                android:textColor="#27352B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shoppingItemQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quantity: 2"
                android:textColor="#7A857E"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/editShoppingItemButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#2F6B42"
            android:textSize="22sp"
            android:contentDescription="Edit shopping item" />

        <TextView
            android:id="@+id/deleteShoppingItemButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#8A3B3B"
            android:textSize="19sp"
            android:contentDescription="Delete shopping item" />

    </LinearLayout>

</androidx.cardview.widget.CardView>