<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:backgroundTint="#FFFFFF"
    android:elevation="0dp"
    android:radius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Expiry icon -->
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_circle_orange"
            android:gravity="center"
            android:text="⏰"
            android:textSize="21sp" />

        <!-- Item information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/expiringItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Milk"
                android:textColor="#27352B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expiringItemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Dairy"
                android:textColor="#7A857E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/expiringItemExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Expires: 2026-09-08"
                android:textColor="#B45309"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Arrow -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#839087"
            android:textSize="28sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>